<Window x:Class="Mindows.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mindows"
        Title="Mindows Menu Bar" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Left="-20000" Top="-20000" Width="10" Height="10"
        Background="{DynamicResource BarBg}" Foreground="{DynamicResource BarFg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" TextOptions.TextHintingMode="Animated">
    <Window.Resources>
        <local:TrayIconTint x:Key="TrayIconTint"/>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource BarFg}"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="1,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="False">
        <!-- As on macOS, the menu titles sit closer together than the status items on the right. -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="9,0,0,0">
            <Button x:Name="LogoButton" Style="{StaticResource BarButton}" Padding="8,0" Click="Logo_Click">
                <!-- The taskbar's Start logo (Icons\WindowsLogo.svg in the shell's Client.Core package). -->
                <Path Width="13" Height="13" Stretch="Uniform"
                      Data="M5.5,11.5 H0.5 C0.2239,11.5 0,11.2761 0,11 V6 H5.5 Z M11.5,11 C11.5,11.2761 11.2761,11.5 11,11.5 H6 V6 H11.5 Z
                            M5.5,5.5 H0 V0.5 C0,0.2239 0.2239,0 0.5,0 H5.5 Z M11,0 C11.2761,0 11.5,0.2239 11.5,0.5 V5.5 H6 V0 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.1515,0" EndPoint="0.803,1">
                            <GradientStop Color="#4DD2FF" Offset="0"/>
                            <GradientStop Color="#0078D4" Offset="0.75"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Button>
            <Button x:Name="AppButton" Style="{StaticResource BarButton}" Padding="8,0" Click="App_Click">
                <TextBlock x:Name="AppName" FontWeight="Bold" Text="Mindows"/>
            </Button>
            <Button x:Name="WindowButton" Style="{StaticResource BarButton}" Padding="8,0" Click="Window_Click">
                <TextBlock Text="윈도우"/>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
            <!-- Tray icons beyond the configured maximum, leftmost of the right side. -->
            <Button x:Name="TrayOverflow" Style="{StaticResource BarButton}" Padding="8,0" Visibility="Collapsed"
                    Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                    AutomationProperties.Name="더 보기" Click="TrayOverflow_Click"/>
            <!-- AI usage from UsageBar, a separate app: each provider's mark and the percentage left; clicks open its popup. -->
            <ItemsControl x:Name="UsageItems" VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource BarButton}" Click="Usage_Click" ToolTip="{Binding Tip}" Opacity="{Binding Opacity}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding Logo}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource BarFg}"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Text}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Tray icons hosted by Mindows; mouse input is forwarded to the owning app. -->
            <ItemsControl x:Name="TrayIcons" VerticalAlignment="Stretch" MouseMove="TrayIcons_MouseMove"
                          MouseLeftButtonUp="TrayIcons_MouseUp" LostMouseCapture="TrayIcons_LostMouseCapture">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="5" Padding="8,0" Margin="1,3"
                                MouseDown="Tray_MouseDown" MouseUp="Tray_MouseUp" MouseEnter="Tray_MouseEnter"
                                MouseLeave="Tray_MouseLeave" MouseMove="Tray_MouseMove" MouseWheel="Tray_MouseWheel">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Hover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid VerticalAlignment="Center">
                                <Image x:Name="Icon" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <!-- The window's Foreground follows BarFg, so the icon is re-tinted when the bar's text color flips. -->
                                        <MultiBinding Converter="{StaticResource TrayIconTint}">
                                            <Binding Path="Icon"/>
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <!-- macOS speaker.wave.3.fill in place of Windows' volume icon; clicks still reach it.
                                     The macOS icons here are traced over menu bar captures, in pt as DIPs.
                                     As with Wi-Fi, the waves beyond the volume are dimmed; the percentage follows, as with the battery. -->
                                <StackPanel x:Name="Speaker" Orientation="Horizontal" Visibility="Collapsed"
                                            DataContext="{Binding Volume, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Viewbox Width="18.4" Height="12.4" Stretch="Fill" VerticalAlignment="Center">
                                        <Canvas Width="17.5" Height="12.5">
                                            <Path Fill="{DynamicResource BarFg}" Stroke="{DynamicResource BarFg}" StrokeThickness="0.7" StrokeLineJoin="Round"
                                                  Data="M0.35,3.7 L2.9,3.7 7.45,0.35 7.45,12.15 2.9,8.8 0.35,8.8 Z"/>
                                            <Path Stroke="{DynamicResource BarFg}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M10.07,3.36 A5.45,5.45 0 0 1 10.07,9.14" Opacity="{Binding Wave1}"/>
                                            <Path Stroke="{DynamicResource BarFg}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M12.83,1.64 A8.7,8.7 0 0 1 12.83,10.86" Opacity="{Binding Wave2}"/>
                                            <Path Stroke="{DynamicResource BarFg}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M15.4,0.6 A11.9,11.9 0 0 1 15.4,11.9" Opacity="{Binding Wave3}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Text}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Identifier}" Value="7820ae73-23e3-4229-82c1-e41cb67d5b9c"> <!-- VOLUME_GUID -->
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Speaker" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="ImeButton" Style="{StaticResource BarButton}" Click="Ime_Click" Visibility="Collapsed">
                <!-- A badge with its text cut out, so the bar shows through it, as on macOS; drawn in UpdateIme. -->
                <Path x:Name="ImeBadge" Width="21.5" Height="15.5" Fill="{DynamicResource BarFg}"/>
            </Button>
            <Button Style="{StaticResource BarButton}" Click="Network_Click">
                <Grid>
                    <!-- Wired: ‹···› -->
                    <Canvas x:Name="Ethernet" Width="18.5" Height="10" Visibility="Collapsed">
                        <Path Stroke="{DynamicResource BarFg}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Data="M4.75,0.8 L0.8,5 4.75,9.2 M13.75,0.8 L17.7,5 13.75,9.2"/>
                        <Path Fill="{DynamicResource BarFg}">
                            <Path.Data>
                                <GeometryGroup>
                                    <EllipseGeometry Center="5.75,5" RadiusX="1" RadiusY="1"/>
                                    <EllipseGeometry Center="9.25,5" RadiusX="1" RadiusY="1"/>
                                    <EllipseGeometry Center="12.75,5" RadiusX="1" RadiusY="1"/>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </Canvas>
                    <!-- Wi-Fi: a rounded wedge and two arcs; the ones beyond the signal strength are dimmed. -->
                    <Canvas x:Name="Wifi" Width="15.5" Height="11.5">
                        <Path x:Name="WifiBar1" Fill="{DynamicResource BarFg}" Stroke="{DynamicResource BarFg}" StrokeThickness="0.8"
                              StrokeLineJoin="Round" Data="M7.75,10.9 L6.09,9.24 A2.35,2.35 0 0 1 9.41,9.24 Z"/>
                        <Path x:Name="WifiBar2" Stroke="{DynamicResource BarFg}" StrokeThickness="2.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M3.75,6.55 A5.65,5.65 0 0 1 11.75,6.55"/>
                        <Path x:Name="WifiBar3" Stroke="{DynamicResource BarFg}" StrokeThickness="2.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M1.05,3.8 A9.55,9.55 0 0 1 14.45,3.8"/>
                    </Canvas>
                </Grid>
            </Button>
            <Button x:Name="BatteryButton" Style="{StaticResource BarButton}" Click="Battery_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="23" Height="11" BorderThickness="1" CornerRadius="3" Padding="1.5"
                            BorderBrush="{DynamicResource BarFg}" VerticalAlignment="Center">
                        <Border x:Name="BatteryFill" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{DynamicResource BarFg}"/>
                    </Border>
                    <Border Width="1.5" Height="4" Margin="1,0,0,0" CornerRadius="0,1,1,0" Opacity="0.6"
                            Background="{DynamicResource BarFg}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BatteryText" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource BarButton}" Click="Control_Click" ToolTip="빠른 설정">
                <!-- macOS Control Center (switch.2): an off switch over an on switch, each with a capsule knob. -->
                <Path Width="12.5" Height="12.5" Fill="{DynamicResource BarFg}">
                    <Path.Data>
                        <GeometryGroup FillRule="EvenOdd">
                            <RectangleGeometry Rect="0,0,12.5,5.2" RadiusX="2.6" RadiusY="2.6"/>
                            <RectangleGeometry Rect="1,1,10.5,3.2" RadiusX="1.6" RadiusY="1.6"/>
                            <RectangleGeometry Rect="1.55,1.55,5.05,2.1" RadiusX="1.05" RadiusY="1.05"/>
                            <RectangleGeometry Rect="0,7.3,12.5,5.2" RadiusX="2.6" RadiusY="2.6"/>
                            <RectangleGeometry Rect="5.35,8.3,6.15,3.2" RadiusX="1.6" RadiusY="1.6"/>
                            <RectangleGeometry Rect="5.9,8.85,5.05,2.1" RadiusX="1.05" RadiusY="1.05"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
            </Button>
            <Button Style="{StaticResource BarButton}" Click="Clock_Click">
                <TextBlock x:Name="Clock" Typography.NumeralAlignment="Tabular"/>
            </Button>
        </StackPanel>
    </DockPanel>
</Window>
