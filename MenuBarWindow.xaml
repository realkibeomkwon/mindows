<Window x:Class="Mindows.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mindows Menu Bar" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Left="-20000" Top="-20000" Width="10" Height="10"
        Background="{DynamicResource BarBg}" Foreground="{DynamicResource BarFg}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource BarFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="9,0" Margin="1,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0,0,0">
            <Button x:Name="LogoButton" Style="{StaticResource BarButton}" Click="Logo_Click">
                <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource BarFg}"
                      Data="M0,0 H7 V7 H0 Z M8,0 H15 V7 H8 Z M0,8 H7 V15 H0 Z M8,8 H15 V15 H8 Z"/>
            </Button>
            <Button x:Name="AppButton" Style="{StaticResource BarButton}" Click="App_Click">
                <TextBlock x:Name="AppName" FontWeight="Bold" Text="Mindows"/>
            </Button>
            <Button x:Name="WindowButton" Style="{StaticResource BarButton}" Click="Window_Click">
                <TextBlock Text="윈도우"/>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
            <!-- Tray icons hosted by Mindows; mouse input is forwarded to the owning app. -->
            <ItemsControl x:Name="TrayIcons" VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="5" Padding="6,0" Margin="1,3"
                                MouseDown="Tray_MouseDown" MouseUp="Tray_MouseUp" MouseEnter="Tray_MouseEnter"
                                MouseLeave="Tray_MouseLeave" MouseMove="Tray_MouseMove">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Hover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="BatteryButton" Style="{StaticResource BarButton}" Click="Battery_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BatteryText" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border Width="23" Height="11" BorderThickness="1" CornerRadius="3" Padding="1.5"
                            BorderBrush="{DynamicResource BarFg}" VerticalAlignment="Center">
                        <Border x:Name="BatteryFill" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{DynamicResource BarFg}"/>
                    </Border>
                    <Border Width="1.5" Height="4" Margin="1,0,0,0" CornerRadius="0,1,1,0" Opacity="0.6"
                            Background="{DynamicResource BarFg}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource BarButton}" Click="Control_Click" ToolTip="빠른 설정">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"/>
            </Button>
            <Button Style="{StaticResource BarButton}" Click="Search_Click" ToolTip="검색">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"/>
            </Button>
            <Button Style="{StaticResource BarButton}" Click="Clock_Click">
                <TextBlock x:Name="Clock"/>
            </Button>
        </StackPanel>
    </DockPanel>
</Window>
