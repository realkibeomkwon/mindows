<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Mindows.ico</ApplicationIcon>
    <RootNamespace>Mindows</RootNamespace>
    <Version>1.0.0</Version>
    <!-- No background GC thread for an app that is idle almost always. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Precompiles Mindows.dll and ManagedShell at publish (needs the -r in the publish command). -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- dotnet publish ... -p:UiAccess=true: see README. Not tied to Release, since dotnet run -c Release runs from bin\ and a uiAccess exe only starts from Program Files. -->
  <PropertyGroup Condition="'$(UiAccess)' == 'true'">
    <ApplicationManifest>app.uiaccess.manifest</ApplicationManifest>
    <!-- Changes the compiler inputs, so toggling UiAccess rebuilds the dll and apphost instead of reusing the old manifest. -->
    <DefineConstants>$(DefineConstants);UIACCESS</DefineConstants>
    <SigningSubject>Mindows Local Code Signing</SigningSubject>
  </PropertyGroup>

  <Target Name="SignUiAccess" AfterTargets="Publish" Condition="'$(UiAccess)' == 'true'">
    <ItemGroup>
      <SignToolCandidate Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\*\x64\signtool.exe" />
    </ItemGroup>
    <PropertyGroup>
      <SignTool>%(SignToolCandidate.FullPath)</SignTool>
    </PropertyGroup>
    <Error Condition="'$(SignTool)' == ''" Text="signtool.exe not found; install the Windows SDK." />
    <!-- An unsigned uiAccess exe will not start, so a missing certificate fails the publish. -->
    <Exec Command="&quot;$(SignTool)&quot; sign /fd sha256 /n &quot;$(SigningSubject)&quot; /s My &quot;$(PublishDir)$(AssemblyName).exe&quot;" />
  </Target>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.otf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <!-- ManagedShell's full-screen check loads System.Windows.Forms; a self-contained publish ships only the WPF part otherwise. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

</Project>
