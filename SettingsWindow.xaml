<Window x:Class="Mindows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mindows"
        Title="Mindows 설정" Width="820" Height="480" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource MenuFg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" TextOptions.TextHintingMode="Animated">
    <Window.Resources>
        <!-- Sidebar entry: Tag holds a Segoe Fluent Icons glyph. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="8,6" Margin="0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="7" Background="{TemplateBinding Background}" Margin="0,0,10,0">
                                    <ContentPresenter Content="{TemplateBinding Tag}"
                                                      TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                      TextElement.FontSize="14" TextElement.Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter x:Name="Hdr" ContentSource="Header" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="Hdr" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A group of rows, as on macOS. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="46"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource MenuBorder}"/>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="{DynamicResource MenuBorder}">
                            <Ellipse x:Name="Knob" Width="18" Height="18" Margin="2,0" Fill="White" HorizontalAlignment="Left">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource MenuFg}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="5" Padding="2,3" BorderThickness="1"
                                Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource MenuBorder}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A macOS pop-up button: the current choice and an up/down chevron; clicking opens the choices as a menu. -->
        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Height="30" CornerRadius="6" Padding="10,0,6,0" BorderThickness="2"
                                Background="{DynamicResource MenuBorder}" BorderBrush="Transparent">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8"/>
                                </StackPanel>
                                <ContentPresenter VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A shortcut field: shows the keys; clicking it records the next combination pressed. -->
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Height="30" CornerRadius="6" Padding="10,0" BorderThickness="2"
                                Background="{DynamicResource MenuBorder}" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The corner marks on the hot corners preview. -->
        <Style x:Key="CornerMark" TargetType="Path">
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="#99000000"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource MenuBorder}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="White" Stroke="{DynamicResource MenuBorder}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Each TabItem is one category: the sidebar lists them, the right pane shows the selected one. -->
    <TabControl TabStripPlacement="Left" Focusable="False">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PaneBg}">
                        <StackPanel IsItemsHost="True" Margin="12,16" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBg}">
                        <StackPanel Margin="24,20,24,8">
                            <TextBlock Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="17" FontWeight="SemiBold" Margin="2,0,0,18" Foreground="{DynamicResource MenuFg}"/>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Header="일반" Tag="&#xE713;" Background="#8E8E93">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox x:Name="LaunchAtLogin" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                  AutomationProperties.Name="로그인 시 자동 실행" Click="LaunchAtLogin_Click"/>
                        <TextBlock Text="로그인 시 자동 실행" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </TabItem>

        <TabItem Header="외관" Tag="&#xE790;" Background="#32ADE6">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox x:Name="Translucency" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                  AutomationProperties.Name="창 투명 효과" Click="Translucency_Click"/>
                        <TextBlock Text="창 투명 효과" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource RowLine}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox x:Name="MenuBarTransparent" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                  AutomationProperties.Name="메뉴 막대 투명" Click="MenuBarTransparent_Click"/>
                        <TextBlock Text="메뉴 막대 투명" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </TabItem>

        <TabItem Header="Dock" Background="#5E5CE6">
            <!-- The macOS Desktop & Dock glyph: a screen outline with the dock bar along its bottom. -->
            <TabItem.Tag>
                <Grid Width="15" Height="12">
                    <Border BorderBrush="White" BorderThickness="1.5" CornerRadius="3"/>
                    <Border Width="9" Height="2.5" CornerRadius="1.25" Background="White"
                            VerticalAlignment="Bottom" Margin="0,0,0,2.5"/>
                </Grid>
            </TabItem.Tag>
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Grid DockPanel.Dock="Right" Width="290" VerticalAlignment="Center" Margin="0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Declared before the slider: the slider's ValueChanged writes to it during InitializeComponent. -->
                                <TextBox x:Name="IconSizeBox" Grid.Column="1" Width="44" Margin="10,0,0,0" MaxLength="3"
                                         VerticalAlignment="Center" AutomationProperties.Name="크기 값"
                                         KeyDown="IconSizeBox_KeyDown" LostKeyboardFocus="IconSizeBox_LostKeyboardFocus"/>
                                <Slider x:Name="IconSize" Minimum="{x:Static local:Config.MinIconSize}"
                                        Maximum="{x:Static local:Config.MaxIconSize}" SmallChange="4" LargeChange="8"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        IsMoveToPointEnabled="True" AutomationProperties.Name="크기"
                                        ValueChanged="IconSize_ValueChanged" Thumb.DragCompleted="IconSize_DragCompleted"/>
                                <TextBlock Grid.Row="1" Text="작게" FontSize="11" Opacity="0.6"/>
                                <TextBlock Grid.Row="1" Text="크게" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="크기" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="Magnification" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="확대 효과" Click="Magnification_Click"/>
                            <TextBlock Text="확대 효과" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="AutoHide" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="자동으로 Dock 가리기 및 보기" Click="AutoHide_Click"/>
                            <TextBlock Text="자동으로 Dock 가리기 및 보기" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=AutoHide}">
                            <CheckBox x:Name="AutoHideAnimation" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="가리기 및 보기 애니메이션" Click="AutoHideAnimation_Click"/>
                            <TextBlock Text="가리기 및 보기 애니메이션" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>

        <TabItem Header="트레이 아이콘" Tag="&#xE8A9;" Background="#FF9500">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <DockPanel Style="{StaticResource Row}">
                        <TextBox x:Name="MaxTrayBox" DockPanel.Dock="Right" Width="44" MaxLength="2" VerticalAlignment="Center"
                                 AutomationProperties.Name="메뉴 막대에 표시할 최대 개수"
                                 KeyDown="MaxTrayBox_KeyDown" LostKeyboardFocus="MaxTrayBox_LostKeyboardFocus"/>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="최대 표시 개수 (0은 제한 없음)"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel x:Name="TrayList"/>
                        <TextBlock x:Name="TrayEmpty" Text="표시할 트레이 아이콘이 없습니다." Opacity="0.6" Margin="0,14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>

        <TabItem Header="핫 코너" Tag="&#xE740;" Background="#34C759">
            <Border Style="{StaticResource Card}">
                <Grid Margin="0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CornerTopLeft" Style="{StaticResource PopupButton}" VerticalAlignment="Top"
                            AutomationProperties.Name="왼쪽 위 핫 코너" Click="Corner_Click"/>
                    <Button x:Name="CornerBottomLeft" Grid.Row="1" Style="{StaticResource PopupButton}" VerticalAlignment="Bottom"
                            AutomationProperties.Name="왼쪽 아래 핫 코너" Click="Corner_Click"/>
                    <Button x:Name="CornerTopRight" Grid.Column="2" Style="{StaticResource PopupButton}" VerticalAlignment="Top"
                            AutomationProperties.Name="오른쪽 위 핫 코너" Click="Corner_Click"/>
                    <Button x:Name="CornerBottomRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource PopupButton}"
                            VerticalAlignment="Bottom" AutomationProperties.Name="오른쪽 아래 핫 코너" Click="Corner_Click"/>
                    <!-- The desktop picture, its corners marked; the gray shows when there is no picture. -->
                    <Grid Grid.Column="1" Grid.RowSpan="2" Width="150" Height="94" Margin="14,0" Background="{DynamicResource MenuBorder}">
                        <Image x:Name="WallpaperPreview" Stretch="UniformToFill"/>
                        <Path Style="{StaticResource CornerMark}" Data="M1,1 L13,1 L1,13 Z" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Style="{StaticResource CornerMark}" Data="M1,1 L13,1 L13,13 Z" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Path Style="{StaticResource CornerMark}" Data="M1,1 L1,13 L13,13 Z" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Path Style="{StaticResource CornerMark}" Data="M13,1 L13,13 L1,13 Z" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>
        </TabItem>

        <TabItem Header="가상 데스크탑" Tag="&#xE7C4;" Background="#007AFF">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="DesktopList"/>
                </Border>
                <TextBlock x:Name="DesktopCount" Opacity="0.6" Margin="2,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
