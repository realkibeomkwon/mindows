<UserControl x:Class="Mindows.BatteryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="288" Margin="-6" Focusable="False">
    <UserControl.Resources>
        <!-- One segment of the power mode switch: the chosen one is filled, the others only dim until hovered. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" MinHeight="28" Background="Transparent">
                            <ContentPresenter x:Name="Cp" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                <Setter TargetName="Cp" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="14,12,14,0">
            <TextBlock x:Name="State" FontSize="13" FontWeight="SemiBold" Opacity="0.6"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center">
                    <Run x:Name="Percent" FontSize="34" FontWeight="SemiBold"/><Run Text="%" FontSize="18"/>
                </TextBlock>
                <!-- Same bolt as over the menu bar battery, shown while charging. -->
                <Path x:Name="Bolt" Visibility="Collapsed" Width="14" Height="24" Stretch="Fill" Margin="8,0,0,0" VerticalAlignment="Center"
                      Fill="#FFE600" Stroke="#CC000000" StrokeThickness="0.8" StrokeLineJoin="Round"
                      Data="M3.8,0 L0.4,5.4 L2.5,5.4 L1.9,9 L5.6,3.4 L3.4,3.4 Z"/>
            </StackPanel>
            <Border Height="8" CornerRadius="4" Margin="0,8,0,10" Background="{DynamicResource Hover}">
                <Border x:Name="Fill" HorizontalAlignment="Left" CornerRadius="4"/>
            </Border>
            <Grid x:Name="TimeRow" Margin="0,0,0,4">
                <TextBlock x:Name="TimeLabel" Opacity="0.6"/>
                <TextBlock x:Name="TimeValue" HorizontalAlignment="Right"/>
            </Grid>
            <Grid>
                <TextBlock Text="전원" Opacity="0.6"/>
                <TextBlock x:Name="Source" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <Border Height="1" Margin="0,12" Background="{DynamicResource MenuBorder}"/>

        <StackPanel Margin="14,0">
            <TextBlock Text="전원 모드" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,7"/>
            <Border CornerRadius="9" Padding="2" Background="{DynamicResource Hover}">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="ModeEfficiency" Style="{StaticResource Segment}" Content="최고 효율" Click="Mode_Click"/>
                    <RadioButton x:Name="ModeBalanced" Style="{StaticResource Segment}" Content="균형" Click="Mode_Click"/>
                    <RadioButton x:Name="ModePerformance" Style="{StaticResource Segment}" Content="최고 성능" Click="Mode_Click"/>
                </UniformGrid>
            </Border>
        </StackPanel>

        <Border Height="1" Margin="0,12" Background="{DynamicResource MenuBorder}"/>

        <Button Margin="8,0,8,8" Click="Settings_Click" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" MinHeight="26" Padding="6,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            배터리 설정…
        </Button>
    </StackPanel>
</UserControl>
