<Window x:Class="Mindows.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mindows Dock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Left="-20000" Top="-20000" Width="10" Height="10"
        FontFamily="{StaticResource UiFont}" TextOptions.TextHintingMode="Animated">
    <Grid>
        <!-- Items are positioned by hand in Layout(); transparent pixels click through to the desktop. -->
        <Canvas x:Name="Root">
            <Canvas.RenderTransform>
                <TranslateTransform/> <!-- slides the dock below the screen edge when it auto-hides -->
            </Canvas.RenderTransform>
            <Rectangle x:Name="HoverZone" Fill="#01000000" Visibility="Collapsed"/>
            <!-- thin dark outline just outside the shelf, strongest on the straight sides (the rim light covers the corners), as on macOS -->
            <Border x:Name="ShelfEdge" CornerRadius="19" BorderThickness="1" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.2"/>
                        <GradientStop Color="#40000000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="0.8"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <!-- ShelfFill and ShelfRim follow the theme. The rim stays bright on the top and bottom and dies out on the straight sides (corner arc ≈ 0.3 of the height), as on macOS. -->
            <Border x:Name="Shelf" CornerRadius="18" BorderThickness="1"
                    Background="{DynamicResource ShelfFill}" BorderBrush="{DynamicResource ShelfRim}"/>
            <!-- macOS-style name tag: a pill with an arrow, one shape so the fill doesn't double up where they meet. Colored by theme, nearly opaque, so the text never depends on the wallpaper. -->
            <Grid x:Name="Label" Panel.ZIndex="100" Visibility="Collapsed" IsHitTestVisible="False">
                <Path x:Name="LabelShape" Fill="{DynamicResource MenuBg}" Stroke="{DynamicResource MenuBorder}" StrokeThickness="1"/>
                <TextBlock x:Name="LabelText" FontSize="13" Margin="12,3,12,9" Foreground="{DynamicResource TagFg}"/>
            </Grid>
            <!-- The icon being dragged; a popup so it can leave the dock window. -->
            <Popup x:Name="Ghost" AllowsTransparency="True" Placement="Relative" PlacementTarget="{Binding ElementName=Root}"
                   IsHitTestVisible="False">
                <StackPanel x:Name="GhostPanel">
                    <Grid x:Name="RemoveLabel" HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed">
                        <Path x:Name="RemoveShape" Fill="{DynamicResource MenuBg}" Stroke="{DynamicResource MenuBorder}" StrokeThickness="1"/>
                        <TextBlock x:Name="RemoveText" Text="제거" FontSize="13" Margin="12,3,12,9" Foreground="{DynamicResource MenuFg}"/>
                    </Grid>
                    <Image x:Name="GhostImg" RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>
            </Popup>
        </Canvas>
        <!-- While auto-hiding: touching the bottom screen edge brings the dock back. -->
        <Rectangle x:Name="EdgeTrigger" Height="1" VerticalAlignment="Bottom" Fill="#01000000" Visibility="Collapsed"/>
    </Grid>
</Window>
